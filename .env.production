# Produção (usado automaticamente pelo `expo export` / EAS Build).
# O bundle web EMBUTE este valor em build-time: sem este arquivo, o dist
# sai apontando para localhost e o app não funciona fora da máquina (B14).
EXPO_PUBLIC_API_URL=https://api.sfacco.com.br/api/v1

# White-label por domínio (mesma semântica do .env de dev).
EXPO_PUBLIC_VENUE_SLUG=
EXPO_PUBLIC_TENANT_DOMAIN=sfacco.com.br

# Google OAuth de produção (obrigatório p/ o botão Google funcionar).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
