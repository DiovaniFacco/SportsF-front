# API Base URL (desenvolvimento local).
# ATENÇÃO: o bundle web embute esta URL em build-time. Para gerar o dist de
# produção, o Expo carrega automaticamente o `.env.production`
# (EXPO_PUBLIC_API_URL=https://api.sfacco.com.br/api/v1) — nunca publique um
# dist gerado apenas com este .env de dev.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# White-label por domínio (ex: recanto.sfacco.com.br entra direto no complexo).
# Aceita slug ("recanto") ou ID ("1"). O subdomínio tem prioridade sobre esta env.
# Em prod no Railway (service front do Recanto): EXPO_PUBLIC_VENUE_SLUG=recanto
EXPO_PUBLIC_VENUE_SLUG=
# Sufixo do domínio tenant (padrão: sfacco.com.br). Só mude se usar outro domínio.
EXPO_PUBLIC_TENANT_DOMAIN=sfacco.com.br

# Google OAuth Credentials (Obter no Google Cloud Console)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
